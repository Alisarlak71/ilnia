{
  "version": 2,
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.9.0" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    { "src": "/(css|js|fonts|images|brand|storage)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/(favicon\\.svg|apple-touch-icon\\.png)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
